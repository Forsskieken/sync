# Copy to subtitle-sync.env and chmod 600. Never commit the real file.
#
# The JSON values are wrapped in single quotes so that both systemd and a
# shell read them the same way: `. subtitle-sync.env` would otherwise strip
# the inner double quotes and leave invalid JSON behind.
JELLYFIN_URL=http://jellyfin.example.net:8096
JELLYFIN_API_KEY=
PATH_MAP='{"/mnt/jellyfin":"/mnt"}'
ALLOWED_ROOTS='["/mnt/Serie","/mnt/Film"]'
CACHE_DIR=/var/cache/subtitle-sync
# DEBUG, INFO (default), WARNING, ERROR or CRITICAL.
LOG_LEVEL=INFO
# JSON list of language codes for the first row of language tiles when
# embedding or replacing a subtitle track. Display preference only - it
# never labels anything by itself, and unknown codes are skipped.
SUB_LANG_BUTTONS='["nld","eng"]'
