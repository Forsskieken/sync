# Copy to /etc/systemd/system/subtitle-sync.service and adjust the paths.
# The Jellyfin key lives in subtitle-sync.env (mode 600), never in this file.
[Unit]
Description=subtitle-sync - nudge subtitle timings
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Not root: this service overwrites subtitle files. `jan` and `family` are an
# example -- use the account you have and the group that owns the media share.
# The group is what grants write access to ALLOWED_ROOTS; inside a container
# its gid must be the same number there as on the host.
User=jan
Group=family
WorkingDirectory=/opt/subtitle-sync
EnvironmentFile=/opt/subtitle-sync/subtitle-sync.env
# There is no login on this service, so it stays on the loopback by default.
# Reach it through an SSH tunnel, or put a proxy with a password in front.
ExecStart=/opt/subtitle-sync/.venv/bin/uvicorn app:app --host 127.0.0.1 --port 8099
# On a home network where everyone is trusted, swap the two lines above and
# below to reach it from a phone. Anyone on the network can then rewrite
# subtitles under ALLOWED_ROOTS without a password.
#ExecStart=/opt/subtitle-sync/.venv/bin/uvicorn app:app --host 0.0.0.0 --port 8099
Restart=on-failure
RestartSec=5

# The whole filesystem is read-only except the directories named below, so a
# path that escapes ALLOWED_ROOTS still cannot write anything.
ProtectSystem=strict
ProtectHome=yes
# Own /tmp, so the converted audio cannot go to the host's. That is also why
# CACHE_DIR must not be under /tmp: systemd wipes a private one per start, and
# a cleanup timer outside the service would clean the wrong directory.
PrivateTmp=yes
# Creates /var/cache/subtitle-sync, owned by User=, writable without being
# listed in ReadWritePaths. Point CACHE_DIR at it.
CacheDirectory=subtitle-sync
NoNewPrivileges=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
# Keep this list equal to ALLOWED_ROOTS in subtitle-sync.env, or saving fails
# with "Read-only file system" instead of a clear error.
ReadWritePaths=/mnt/Serie /mnt/Film

[Install]
WantedBy=multi-user.target
